<script>
  window.__CHARTS__ = <%- chartDataJSON %>;
  window.__CHART_CONFIG__ = <%- chartConfigJSON %>;
</script>

<div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4 mb-8">
  <% chartData.kpis.forEach(kpi => { %>
  <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm hover:shadow-md transition-shadow">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-gray-500"><%= kpi.label %></p>
        <p class="mt-2 text-3xl font-bold text-gray-900">
          <%
            if (kpi.format === 'pct') {
              out = typeof kpi.value === 'number' ? kpi.value.toFixed(1) + '%' : (kpi.value ?? '—');
            } else if (kpi.format === 'dec1') {
              out = typeof kpi.value === 'number' ? kpi.value.toFixed(1) : (kpi.value ?? '—');
            } else {
              out = typeof kpi.value === 'number' ? kpi.value.toLocaleString() : (kpi.value ?? '—');
            }
            print(out);
          %>
        </p>
      </div>
      <div class="w-12 h-12 rounded-lg bg-primary-100 flex items-center justify-center">
        <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      </div>
    </div>
  </div>
  <% }) %>
</div>

<!-- Charts -->
<div class="grid gap-6 lg:grid-cols-2">
  <% chartData.charts.forEach((chart, idx) => { %>
  <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
    <h3 class="text-lg font-semibold text-gray-900 mb-4"><%= chart.title %></h3>
    <div class="h-80" style="position: relative; height: 320px;">
      <canvas id="chart-<%= idx %>"></canvas>
    </div>
  </div>
  <% }) %>
</div>

<% if (!chartData.charts.length) { %>
<div class="text-center py-12 text-gray-500">
  <p>No chart data available. Import a dataset with numeric columns to see visualizations.</p>
</div>
<% } %>