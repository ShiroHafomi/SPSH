<div class="flex min-h-[60vh] items-center justify-center px-4">
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-8 max-w-2xl w-full text-center">
    <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-danger-100 flex items-center justify-center">
      <svg class="w-8 h-8 text-danger-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
    </div>

    <h1 class="text-2xl font-bold text-gray-900 mb-2"><%= title %></h1>

    <p class="text-gray-600 mb-4"><%= message %></p>

    <% if (locals.details) { %>
    <p class="text-sm text-gray-500 mb-6"><%= details %></p>
    <% } %>

    <% if (locals.commands && locals.commands.length) { %>
    <div class="mb-6 p-4 bg-gray-50 rounded-lg text-left">
      <p class="text-sm font-medium text-gray-700 mb-2">Run one of:</p>
      <ul class="font-mono text-sm space-y-1">
        <% commands.forEach(cmd => { %>
          <li class="text-primary-600"><%= cmd %></li>
        <% }) %>
      </ul>
    </div>
    <% } %>

    <a href="<%= backLink %>" class="inline-flex items-center gap-2 px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition font-medium">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
      Go Back
    </a>
  </div>
</div>