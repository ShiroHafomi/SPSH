<% if (flash && (flash.success || flash.error || flash.created || flash.updated || flash.deleted)) { %>
<div class="mb-6" role="alert">
  <% if (flash.success || flash.created) { %>
  <div class="bg-success-50 border border-success-200 text-success-700 px-4 py-3 rounded-lg flex items-center justify-between">
    <span><%= flash.success || 'Student created successfully!' %></span>
    <button onclick="this.parentElement.remove()" class="text-success-500 hover:text-success-700">&times;</button>
  </div>
  <% } %>
  <% if (flash.updated) { %>
  <div class="bg-primary-50 border border-primary-200 text-primary-700 px-4 py-3 rounded-lg flex items-center justify-between">
    <span>Student updated successfully!</span>
    <button onclick="this.parentElement.remove()" class="text-primary-500 hover:text-primary-700">&times;</button>
  </div>
  <% } %>
  <% if (flash.deleted) { %>
  <div class="bg-warning-50 border border-warning-200 text-warning-700 px-4 py-3 rounded-lg flex items-center justify-between">
    <span>Student deleted successfully.</span>
    <button onclick="this.parentElement.remove()" class="text-warning-500 hover:text-warning-700">&times;</button>
  </div>
  <% } %>
  <% if (flash.error) { %>
  <div class="bg-danger-50 border border-danger-200 text-danger-700 px-4 py-3 rounded-lg flex items-center justify-between">
    <span><%= flash.error %></span>
    <button onclick="this.parentElement.remove()" class="text-danger-500 hover:text-danger-700">&times;</button>
  </div>
  <% } %>
</div>
<% } %>