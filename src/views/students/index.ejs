<div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
  <!-- Header with search and create button -->
  <div class="p-6 border-b border-gray-200 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <h2 class="text-xl font-semibold text-gray-900">Students</h2>

    <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
      <!-- Search form -->
      <form method="GET" action="/students" class="flex-1 flex gap-2">
        <input
          type="search"
          name="q"
          value="<%= q %>"
          placeholder="Search students..."
          class="flex-1 px-4 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent"
        >
        <button type="submit" class="px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-lg hover:bg-primary-700 transition">
          Search
        </button>
        <% if (q) { %>
          <a href="/students" class="px-4 py-2 bg-gray-100 text-gray-600 text-sm font-medium rounded-lg hover:bg-gray-200 transition">
            Clear
          </a>
        <% } %>
      </form>

      <!-- Create button -->
      <a href="/students/new" class="px-4 py-2 bg-success-600 text-white text-sm font-medium rounded-lg hover:bg-success-700 transition self-center">
        + Add Student
      </a>
    </div>
  </div>

  <!-- Table -->
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <% columns.forEach(col => { %>
          <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
            <% if (col.name !== sort) { %>
              <a href="?q=<%= encodeURIComponent(q) %>&sort=<%= col.name %>&dir=asc&page=<%= page %>&size=<%= size %>" class="hover:text-primary-600 transition">
                <%= col.displayLabel %>
              </a>
            <% } else { %>
              <a href="?q=<%= encodeURIComponent(q) %>&sort=<%= col.name %>&dir=<%= dir === 'asc' ? 'desc' : 'asc' %>&page=<%= page %>&size=<%= size %>" class="flex items-center gap-1 text-primary-600 hover:text-primary-700 transition">
                <%= col.displayLabel %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="<%= dir === 'asc' ? 'M5 15l7-7 7 7' : 'M19 9l-7 7-7-7' %>"/>
                </svg>
              </a>
            <% } %>
          </th>
          <% }) %>
          <th class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% if (rows.length === 0) { %>
        <tr>
          <td colspan="<%= columns.length + 1 %>" class="px-4 py-12 text-center text-gray-500">
            No students found<%= q ? ' matching "' + q + '"' : '' %>.
          </td>
        </tr>
        <% } else { %>
        <% rows.forEach(row => { %>
        <tr class="hover:bg-gray-50 transition-colors">
          <% columns.forEach(col => { %>
          <td class="px-4 py-3 text-sm text-gray-900">
            <%
              let val = row[col.name];
              if (val === null || val === undefined) {
                out = '<span class="text-gray-300 italic">—</span>';
              } else if (col.inferredType === 'boolean') {
                out = val ? '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-success-100 text-success-800">Yes</span>' : '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">No</span>';
              } else if (col.inferredType === 'date' || col.inferredType === 'datetime') {
                out = new Date(val).toLocaleDateString();
              } else {
                out = String(val);
              }
              print(out);
            %>
          </td>
          <% }) %>
          <td class="px-4 py-3 text-right">
            <div class="flex items-center justify-end gap-2">
              <a href="/students/<%= row.id %>/edit" class="px-3 py-1.5 text-sm font-medium text-primary-600 bg-primary-50 rounded-lg hover:bg-primary-100 transition">
                Edit
              </a>
              <form method="POST" action="/students/<%= row.id %>/delete" onsubmit="return confirm('Delete this student?');" class="inline">
                <button type="submit" class="px-3 py-1.5 text-sm font-medium text-danger-600 bg-danger-50 rounded-lg hover:bg-danger-100 transition">
                  Delete
                </button>
              </form>
            </div>
          </td>
        </tr>
        <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
  <div class="p-4 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-between gap-4">
    <div class="text-sm text-gray-600">
      Showing page <%= page %> of <%= totalPages %> (<%= total %> total)
    </div>
    <nav class="flex items-center gap-2" aria-label="Pagination">
      <% const prevPage = page > 1 ? page - 1 : 1; %>
      <a href="?q=<%= encodeURIComponent(q) %>&sort=<%= sort %>&dir=<%= dir %>&page=<%= prevPage %>&size=<%= size %>"
         class="px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition <%= page === 1 ? 'opacity-50 pointer-events-none' : '' %>">
        Previous
      </a>

      <% for (let p = 1; p <= totalPages; p++) { %>
        <% if (totalPages <= 7 || p === 1 || p === totalPages || (p >= page - 2 && p <= page + 2)) { %>
          <a href="?q=<%= encodeURIComponent(q) %>&sort=<%= sort %>&dir=<%= dir %>&page=<%= p %>&size=<%= size %>"
             class="px-3 py-1.5 text-sm font-medium rounded-lg transition <%= p === page ? 'bg-primary-600 text-white' : 'text-gray-700 bg-white border border-gray-300 hover:bg-gray-50' %>">
            <%= p %>
          </a>
        <% } else if (p === page - 3 || p === page + 3) { %>
          <span class="px-2 text-gray-400">…</span>
        <% } %>
      <% } %>

      <% const nextPage = page < totalPages ? page + 1 : totalPages; %>
      <a href="?q=<%= encodeURIComponent(q) %>&sort=<%= sort %>&dir=<%= dir %>&page=<%= nextPage %>&size=<%= size %>"
         class="px-3 py-1.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition <%= page === totalPages ? 'opacity-50 pointer-events-none' : '' %>">
        Next
      </a>
    </nav>
  </div>
  <% } %>
</div>