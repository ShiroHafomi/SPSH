# Runtime
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
# Leave blank when Express receives clients directly. In production, use an
# exact proxy address/subnet list (for example: loopback,10.0.0.0/8) or hop count.
TRUST_PROXY=

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=student_performance
DB_TABLE=students

# JWT cookies. Development has stable local fallbacks when these are blank.
# Production requires distinct high-entropy values of at least 32 bytes.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=student-performance-api
JWT_AUDIENCE=student-performance-spa

# Request parsing limits (bytes/count)
JSON_BODY_LIMIT_BYTES=32768
URLENCODED_BODY_LIMIT_BYTES=16384
URLENCODED_PARAMETER_LIMIT=100

# Bootstrap administrator. Required before seed:admin in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Process-local rate limiting. Multi-replica production needs a shared store or
# equivalent reverse-proxy/WAF enforcement.
RATE_LIMIT_MAX_KEYS=5000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=3
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REFRESH_MAX=30
RATE_LIMIT_REFRESH_WINDOW_MS=900000
RATE_LIMIT_PREDICTION_MAX=30
RATE_LIMIT_PREDICTION_WINDOW_MS=900000
RATE_LIMIT_STUDENT_AI_MAX=20
RATE_LIMIT_STUDENT_AI_WINDOW_MS=900000
RATE_LIMIT_TEACHER_AI_MAX=20
RATE_LIMIT_TEACHER_AI_WINDOW_MS=900000
RATE_LIMIT_ADMIN_AI_MAX=20
RATE_LIMIT_ADMIN_AI_WINDOW_MS=900000
RATE_LIMIT_ADMIN_BULK_AI_MAX=5
RATE_LIMIT_ADMIN_BULK_AI_WINDOW_MS=3600000

# ML execution constraints
# Python command to run inference script (use 'python3' on Linux/Mac, 'py' on Windows)
ML_PYTHON_CMD=py
# Maximum concurrent ML subprocesses (default: 2)
ML_MAX_CONCURRENT=2
# Subprocess timeout in milliseconds (default: 15000)
ML_TIMEOUT_MS=15000
